<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NwcIO.Cli</PackageId>
    <Description>Command line tool that reads Autodesk Navisworks files (.nwc, .nwd, .nwf) without Navisworks and exports GLB, OBJ, or JSON.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nwcio</ToolCommandName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NwcIO\NwcIO.csproj" />
  </ItemGroup>

</Project>
